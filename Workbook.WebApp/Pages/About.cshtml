@page
@model AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["BodyClass"] = "dw-prism-bg";
}

<div class="about-3d-banner dw-scene-3d">
    <div class="scene-horizon"></div>
    <div class="scene-emerald"></div>
    <div class="scene-content">
        <span class="hero-eyebrow"><i class="fas fa-info-circle me-1"></i> Inside the Platform</span>
        <h1 class="hero-headline mt-2 mb-3">About <span class="accent">Dev Workbook</span></h1>
        <p class="hero-body">Empowering every developer — new hire, tenured engineer, or contractor — to document their growth, share authentic feedback, and establish healthy communication channels with whoever they report to.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="dw-card p-4 h-100">
                <div class="bento-icon mb-4">
                    <i class="fas fa-lightbulb"></i>
                </div>
                <h3 class="h4 fw-bold mb-3" style="color: var(--text-primary)">Our Mission</h3>
                <p class="text-muted">Whether you're ninety days into a new role, years into your career, or wrapping up a short-term contract, feedback shouldn't live in scattered Slack threads and forgotten calendar invites. We provide developers with a structured, interactive record — from onboarding through quarterly reviews — that builds transparency and trust with whoever they answer to, employer or client.</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="dw-card p-4 h-100">
                <div class="bento-icon mb-4">
                    <i class="fas fa-tools"></i>
                </div>
                <h3 class="h4 fw-bold mb-3" style="color: var(--text-primary)">Core Features</h3>
                <p class="text-muted">From secure passwordless OTP login to live synchronization and automatic mail alerts, Dev Workbook is built to minimize overhead. Draft your answers, submit them section by section, and receive notifications as your team lead reviews them.</p>
            </div>
        </div>
    </div>

    <!-- ── How It Works ── -->
    <div class="mb-5">
        <span class="hero-eyebrow"><i class="fas fa-route me-1"></i> The Workflow</span>
        <h2 class="h3 fw-bold mt-2 mb-2" style="color: var(--text-primary)">How Dev Workbook works</h2>
        <p class="text-muted mb-4" style="max-width: 60ch;">Four steps, start to finish — no hidden logic, no black box.</p>

        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="dw-card p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="about-step-num">1</span>
                        <div class="bento-icon mb-0"><i class="fas fa-user-plus"></i></div>
                    </div>
                    <h4 class="h6 fw-bold mb-2" style="color: var(--text-primary)">Create your profile</h4>
                    <p class="text-muted small mb-0">New hire, tenured engineer, or contractor — set up your profile and link whoever you report to.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="dw-card p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="about-step-num">2</span>
                        <div class="bento-icon mb-0"><i class="fas fa-book-open"></i></div>
                    </div>
                    <h4 class="h6 fw-bold mb-2" style="color: var(--text-primary)">Document your progress</h4>
                    <p class="text-muted small mb-0">Work through structured, configurable sections. Save drafts anytime, submit when ready.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="dw-card p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="about-step-num">3</span>
                        <div class="bento-icon mb-0"><i class="fas fa-bell"></i></div>
                    </div>
                    <h4 class="h6 fw-bold mb-2" style="color: var(--text-primary)">Automatic notification</h4>
                    <p class="text-muted small mb-0">The moment you submit, whoever you report to gets an email — no chasing required.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="dw-card p-4 h-100">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="about-step-num">4</span>
                        <div class="bento-icon mb-0"><i class="fas fa-comments"></i></div>
                    </div>
                    <h4 class="h6 fw-bold mb-2" style="color: var(--text-primary)">Structured feedback loop</h4>
                    <p class="text-muted small mb-0">They review in context and leave feedback, plus a quarterly counter-assessment — building a running record over time.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Data & Trust ── -->
    <div class="mb-5">
        <span class="hero-eyebrow"><i class="fas fa-shield-halved me-1"></i> Built On Trust</span>
        <h2 class="h3 fw-bold mt-2 mb-2" style="color: var(--text-primary)">How your data is handled</h2>
        <p class="text-muted mb-4" style="max-width: 60ch;">Since this platform sits between you and whoever you report to, here's exactly what protects your information.</p>

        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="dw-card p-4 h-100">
                    <div class="bento-icon mb-3"><i class="fas fa-lock"></i></div>
                    <h4 class="h6 fw-bold mb-2" style="color: var(--text-primary)">Encrypted in transit</h4>
                    <p class="text-muted small mb-0">Every page is served over HTTPS, and session cookies are marked secure and HTTP-only — never readable by client-side scripts.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="dw-card p-4 h-100">
                    <div class="bento-icon mb-3"><i class="fas fa-key"></i></div>
                    <h4 class="h6 fw-bold mb-2" style="color: var(--text-primary)">No plain-text passwords</h4>
                    <p class="text-muted small mb-0">Passwords are hashed before they ever reach the database. Nobody, including us, can read your password back out.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="dw-card p-4 h-100">
                    <div class="bento-icon mb-3"><i class="fas fa-user-shield"></i></div>
                    <h4 class="h6 fw-bold mb-2" style="color: var(--text-primary)">Passwordless manager access</h4>
                    <p class="text-muted small mb-0">Managers sign in with a single-use code that expires in 10 minutes — no standing manager password to leak or reuse.</p>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="dw-card p-4 h-100">
                    <div class="bento-icon mb-3"><i class="fas fa-ban"></i></div>
                    <h4 class="h6 fw-bold mb-2" style="color: var(--text-primary)">Never sold or shared</h4>
                    <p class="text-muted small mb-0">Your data lives in a private MongoDB Atlas database and is used only to run the app you signed up for.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="dw-card p-5 text-center">
        <h3 class="h4 fw-bold mb-3" style="color: var(--text-primary)">Built With Modern Engineering</h3>
        <p class="text-muted mb-4 max-w-[65ch] mx-auto">
            Dev Workbook is built using ASP.NET Core Razor Pages, MediatR CQRS pattern, MongoDB database, and clean HTML5/CSS3 — and it's fully open source, so you don't have to take our word for any of this. Read the code yourself.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="https://github.com/Ofentse-Pholosi/DeveloperWorkbook" target="_blank" class="btn-hero-ghost" style="width: auto;">
                <i class="fab fa-github me-1"></i> View Source on GitHub
            </a>
            <a href="https://www.linkedin.com/in/ofentse-pholosi" target="_blank" class="btn-hero-primary" style="width: auto;">
                <i class="fab fa-linkedin me-1"></i> Connect on LinkedIn
            </a>
        </div>
    </div>
</div>
