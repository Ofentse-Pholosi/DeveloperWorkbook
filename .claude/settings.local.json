      "Bash(curl -s -o /dev/null -w \"ManagerPerformanceReview redirect: %{http_code} -> %{redirect_url}\\\\n\" \"http://localhost:5043/ManagerPerformanceReview?email=test@test.com&quarter=2&year=2026\")",
